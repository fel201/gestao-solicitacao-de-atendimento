{
  "name": "fmps/appointment-management",
  "description": "API for appointment management.",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.0",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "phpunit"
    ]
  }
}
