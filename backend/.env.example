APP_NAME="Solicitação de Atendimento"
APP_KEY=
# você pode modificar isso se caso quiser utilizar outra porta
APP_URL=http://localhost:8000

# permite que seja possível utilizar o docker logs
LOG_STACK=stderr

# conexão do banco de dados da API
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=solicitacao_atendimento
DB_USERNAME=postgres
DB_PASSWORD=postgres

CACHE_STORE=file
SESSION_DRIVER=file


